# Google Gemini API Key (Requerido para IA si no usas Azure OpenAI)
GEMINI_API_KEY=tu-api-key-de-google-ai-studio

# Azure Blob Storage (Para subir las fotos de los perfumes a la nube)
AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=tunombrecuenta;AccountKey=tuclave...;EndpointSuffix=core.windows.net

# Azure OpenAI (Opcional - Proporciona IA con cuotas elevadas sin error 429)
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com
AZURE_OPENAI_API_KEY=tu-clave-azure-openai
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
